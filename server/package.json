{
    "name": "cuecare-server",
    "version": "1.0.0",
    "description": "CueCare backend — Express REST API",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest --runInBand",
        "build": "node src/scripts/build-check.js",
        "seed:appointments": "node src/scripts/seed-appointments.js"
    },
    "dependencies": {
        "better-sqlite3": "^11.8.1",
        "cors": "2.8.5",
        "express": "4.18.3",
        "express-validator": "7.0.1"
    },
    "devDependencies": {
        "jest": "29.7.0",
        "nodemon": "3.1.0",
        "supertest": "7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}
